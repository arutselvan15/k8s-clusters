# Gitignored copy:
#   cp config/aws/clusters/default.yaml.example config/aws/clusters/default.yaml
#
# One file = one cluster. Copy again for a second cluster (lab.yaml, …).
# Build always targets exactly one file:
#   ./scripts/infra/up.sh aws default
#   ./scripts/infra/up.sh aws lab
#
# Keys stay in config/aws/credentials. Region stays in cli.conf.

cluster_name: k8s-aws
control_plane_prefix: cp
worker_prefix: wk

terraform:
  worker_nodes: 1
  node_instance_type: t3.medium
  vpc_cidr: 10.0.0.0/16
  # Tighten to YOUR.PUBLIC.IP/32 when you leave the lab default.
  admin_cidr: 0.0.0.0/0

kubeadm:
  kubernetes_version: "1.32"
  pod_cidr: 192.168.0.0/16
