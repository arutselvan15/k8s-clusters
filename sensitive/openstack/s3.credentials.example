# OpenStack object-store (S3 API) keys. Copy and fill locally:
#   cp sensitive/openstack/s3.credentials.example sensitive/openstack/s3.credentials
#   chmod 600 sensitive/openstack/s3.credentials
#
# Section name must match profile in clusters/backup.yaml (openstack-s3).
# Same INI shape as sensitive/aws/s3.credentials. Keystone auth stays in clouds.yaml.

[openstack-s3]
aws_access_key_id =
aws_secret_access_key =
