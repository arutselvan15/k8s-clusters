# Copy to repo-creds.github.ssh.yaml. Paste the PEM under sshPrivateKey. Gitignored once renamed.
# Use this or the PAT example, not both (same Secret name).
apiVersion: v1
kind: Secret
metadata:
  name: repo-creds-github-com
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repo-creds
stringData:
  url: ssh://git@github.com
  sshPrivateKey: |
    REPLACE_ME
