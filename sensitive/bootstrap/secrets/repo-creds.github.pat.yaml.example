# Copy to repo-creds.github.pat.yaml. Put the token in password. Gitignored once renamed.
# Use this or the SSH example, not both (same Secret name).
apiVersion: v1
kind: Secret
metadata:
  name: repo-creds-github-com
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repo-creds
stringData:
  url: https://github.com
  username: git
  password: REPLACE_ME
