# Gitignored copy lives at .aws/config.
#   cp .aws/config.example .aws/config
#
# scripts/infra/up.sh aws reads region and cluster keys from this file.
# Keys stay in .aws/credentials, never here.

[default]
region = us-east-1
output = json

cluster_name = k8s-aws
kubernetes_version = 1.32
worker_nodes = 1
node_instance_type = t3.medium
vpc_cidr = 10.0.0.0/16
admin_cidr = 0.0.0.0/0
