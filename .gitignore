.kube/
bootstrap/env/bootstrap.env
.idea

# Terraform runtime (keep *.tf and STEPS.md tracked)
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
*.tfplan
terraform.tfvars

# Lab inputs (copy from *.example; never commit secrets)
config/aws/credentials
config/aws/cli.conf
config/aws/infra.yaml
config/aws/infra.conf
config/aws/clusters/*.yaml
!config/aws/clusters/*.yaml.example
config/openstack/clouds.yaml
config/openstack/infra.yaml
config/openstack/infra.conf
config/openstack/clusters/*.yaml
!config/openstack/clusters/*.yaml.example

# Lab outputs (kubeconfig, SSH keys, inventory)
clusters/**
!clusters/README.md

# Legacy locations (if leftover local files exist)
.aws/credentials
.aws/config
.aws/*.pem
.aws/known_hosts
.openstack/clouds.yaml
.openstack/config
.openstack/*.pem
