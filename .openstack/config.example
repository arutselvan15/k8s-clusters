# Gitignored copy lives at .openstack/config.
#   cp .openstack/config.example .openstack/config
#
# scripts/infra/up.sh openstack reads lab settings from this file.
# Auth stays in clouds.yaml, never here.
#
# Fill image_name, node_flavor, network_name from Horizon or:
#   export OS_CLIENT_CONFIG_FILE=$PWD/.openstack/clouds.yaml OS_CLOUD=lab
#   openstack image list
#   openstack flavor list
#   openstack network list

[default]
cloud = lab
cluster_name = k8s-os
kubernetes_version = 1.32
worker_nodes = 1
ssh_user = ubuntu
admin_cidr = 0.0.0.0/0
root_volume_gb = 20
availability_zone =

# Cloud-specific (no defaults that work everywhere).
image_name = REPLACE_ME
node_flavor = REPLACE_ME
# Existing Neutron network; Terraform does not create a new one.
network_name = tenant-internal-direct-net
