# Copy to sensitive/openstack/clouds.yaml (never commit that file).
#   cp clusters/openstack/clouds.yaml.example sensitive/openstack/clouds.yaml
#   chmod 600 sensitive/openstack/clouds.yaml
#
# The cloud name must match `cloud:` in clusters/openstack/*.yaml (default: lab).

clouds:
  lab:
    auth:
      auth_url: https://KEYSTONE.example:5000
      username: REPLACE_ME
      password: REPLACE_ME
      project_name: REPLACE_ME
      user_domain_name: Default
      project_domain_name: Default
    region_name: RegionOne
    interface: public
    identity_api_version: 3

    # Application credentials instead of username/password:
    # auth:
    #   auth_url: https://KEYSTONE.example:5000
    #   application_credential_id: REPLACE_ME
    #   application_credential_secret: REPLACE_ME
    # auth_type: v3applicationcredential
