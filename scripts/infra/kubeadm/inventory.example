# Generated at sensitive/<env>/<cluster_name>/cluster.env (gitignored). Do not copy secrets here.
#
#   ./scripts/infra/up.sh aws k8s-aws
#   ./scripts/infra/kubeadm/up.sh aws k8s-aws
#
# WORKER_HOSTS is space-separated (zero or more).

SSH_USER=ubuntu
SSH_KEY=sensitive/aws/k8s-aws/ssh.pem
CONTROL_PLANE_HOST=REPLACE_ME
CONTROL_PLANE_ENDPOINT=REPLACE_ME
WORKER_HOSTS=REPLACE_ME
K8S_VERSION=1.32
POD_CIDR=192.168.0.0/16
KUBECONFIG_FILE=sensitive/aws/k8s-aws/kubeconfig
