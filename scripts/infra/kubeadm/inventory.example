# Generated at clusters/<env>/cluster.env (gitignored). Do not copy secrets here.
#
#   ./scripts/infra/up.sh aws         # writes clusters/aws/cluster.env
#   ./scripts/infra/kubeadm/up.sh
#   ./scripts/infra/kubeadm/up.sh -i clusters/openstack/cluster.env
#
# WORKER_HOSTS is space-separated (zero or more).

SSH_USER=ubuntu
SSH_KEY=clusters/aws/ssh.pem
CONTROL_PLANE_HOST=REPLACE_ME
CONTROL_PLANE_ENDPOINT=REPLACE_ME
WORKER_HOSTS=REPLACE_ME
K8S_VERSION=1.32
POD_CIDR=192.168.0.0/16
KUBECONFIG_FILE=clusters/aws/kubeconfig
