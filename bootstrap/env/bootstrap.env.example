# Copy to sensitive/bootstrap/bootstrap.env (gitignored). Never commit secrets.
#
#   mkdir -p sensitive/bootstrap
#   cp bootstrap/env/bootstrap.env.example sensitive/bootstrap/bootstrap.env

# Private GitHub — ${VAR} in argocd/repos/repo-creds.*.yaml (envsubst at install)
# GITHUB_PAT=
# GITHUB_SSH_PRIVATE_KEY_B64=

# Argo CD UI (user admin). Patched after Helm if set.
# ARGOCD_ADMIN_PASSWORD=
